# ============================================
# TRAVISTA - Environment Variables Template
# ============================================
# Copy this file to .env.local and fill in your actual values

# ============================================
# DATABASE
# ============================================
# MongoDB connection string
# Local: mongodb://localhost:27017/travista
# Cloud (MongoDB Atlas): mongodb+srv://username:password@cluster.mongodb.net/travista?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/travista

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# JWT secret for signing tokens (use a strong random string in production)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============================================
# EMAIL CONFIGURATION (SMTP)
# ============================================
# SMTP Host (e.g., smtp.gmail.com, smtp.mailgun.org)
SMTP_HOST=smtp.gmail.com

# SMTP Port (usually 587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP Security (false for TLS on port 587, true for SSL on port 465)
SMTP_SECURE=false

# SMTP Username (your email address)
SMTP_USER=your-email@gmail.com

# SMTP Password (app password for Gmail, regular password for others)
# For Gmail: https://myaccount.google.com/apppasswords
SMTP_PASS=your-16-char-app-password

# Email address to send from
FROM_EMAIL=noreply@travista.com

# ============================================
# SQUAD PAYMENT GATEWAY
# ============================================
# Squad Public Key (for client-side, can be used in frontend if needed)
SQUAD_PUBLIC_KEY=pk_live_xxxxxxxxxxxxx

# Squad Secret Key (NEVER expose in frontend, server-side only)
SQUAD_SECRET_KEY=sk_live_xxxxxxxxxxxxx

# ============================================
# BASE URL
# ============================================
# Full URL where the app is hosted (used for email links, redirects, webhooks)
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ============================================
# WHATSAPP INTEGRATION (Optional)
# ============================================
# WhatsApp Business API Token (optional, will fallback to wa.me links if not set)
# Only needed if you want to send WhatsApp messages via API
# WHATSAPP_API_TOKEN=your_whatsapp_api_token

# WhatsApp Phone Number ID (required if using WHATSAPP_API_TOKEN)
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# ============================================
# OPTIONAL: NEXT.JS CONFIGURATION
# ============================================
# NODE_ENV=development
# Set to 'production' when deploying

# ============================================
# SETUP GUIDE
# ============================================
# 1. DATABASE
#    - Local: Install MongoDB and start it
#    - Cloud: Create account at mongodb.com/cloud/atlas
#
# 2. EMAIL (SMTP)
#    - Gmail: Enable app passwords at myaccount.google.com/apppasswords
#    - Other: Check your email provider's SMTP settings
#
# 3. SQUAD PAYMENT
#    - Go to https://squademerchant.com
#    - Navigate to Settings → API Keys
#    - Copy your keys (use test keys for development)
#
# 4. WHATSAPP (Optional)
#    - Create Business Account at whatsapp.com/business
#    - Create app at developers.facebook.com
#    - Get Phone Number ID and access token
#
# ============================================
# SECURITY NOTES
# ============================================
# - NEVER commit this file with real values
# - NEVER share SQUAD_SECRET_KEY or WHATSAPP_API_TOKEN
# - Use strong random string for JWT_SECRET in production
# - Rotate all keys regularly
# - In production, use Vercel Environment Variables (Settings → Environment Variables)
#
# ============================================
